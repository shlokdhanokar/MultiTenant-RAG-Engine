{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",

  "rewrites": [
    { "source": "/api/:path*",    "destination": "https://multi-tenant-rag.duckdns.org/api/:path*" },
    { "source": "/health",        "destination": "https://multi-tenant-rag.duckdns.org/health" },
    { "source": "/image/:path*",  "destination": "https://multi-tenant-rag.duckdns.org/image/:path*" },
    { "source": "/chat/:path*",   "destination": "https://multi-tenant-rag.duckdns.org/chat/:path*" },
    { "source": "/upload/:path*", "destination": "https://multi-tenant-rag.duckdns.org/upload/:path*" },
    { "source": "/admin/:path*",  "destination": "https://multi-tenant-rag.duckdns.org/admin/:path*" },
    { "source": "/:path*",        "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
