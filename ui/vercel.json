{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/health", "destination": "http://161.118.165.207/health" },
    { "source": "/api/:path*", "destination": "http://161.118.165.207/api/:path*" },
    { "source": "/image/:path*", "destination": "http://161.118.165.207/image/:path*" },
    { "source": "/chat/:path*", "destination": "http://161.118.165.207/chat/:path*" },
    { "source": "/upload/:path*", "destination": "http://161.118.165.207/upload/:path*" },
    { "source": "/admin/:path*", "destination": "http://161.118.165.207/admin/:path*" }
  ]
}
