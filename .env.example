# ===== CORE (required) =====
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db_name>?retryWrites=true&w=majority
MONGODB_DB_NAME=rag_db

# Which provider generates answers: groq | openai | gemini
# gemini is the most forgiving on a free tier (~250k tokens/min vs Groq's 12k),
# which matters because each RAG call spends ~9k tokens on retrieved context.
LLM_PROVIDER=gemini

# Groq — free tier, no card required. Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# OpenAI — requires billing credits; the free key alone returns 429
# insufficient_quota. Shares the Groq code path (same chat-completions dialect).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Google Gemini — get a key at https://aistudio.google.com/apikey
# REQUIRED even when LLM_PROVIDER=groq: embeddings are always Gemini
# (Groq serves no embedding model).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the numDimensions of the Atlas vector index (768 / 1536 / 3072).
# Changing this invalidates every stored chunk — re-ingest after any change.
GEMINI_EMBEDDING_DIMENSIONS=1536

# ===== APP CONFIG =====
ENVIRONMENT=development            # development | production
APP_BASE_URL=http://localhost:8000 # public base URL; used to build OAuth redirect + image URLs
MAX_API_KEYS_LIMIT=5                # default max project keys per tenant admin

# ===== SECURITY =====
# Fernet key for encrypting stored OAuth/API-key credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
# HMAC secret for signing time-limited /image/<id> URLs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
IMAGE_URL_SIGNING_SECRET=

# ===== GENERIC INTEGRATIONS (optional, only needed per connected service) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
